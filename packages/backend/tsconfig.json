{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "..",
    "module": "commonjs",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/routes/**",
    "src/middleware/**",
    "src/migrations/**",
    "src/db/client.ts",
    "src/db/queries.ts",
    "src/services/authService.ts",
    "src/services/dataStore.ts"
  ]
}
